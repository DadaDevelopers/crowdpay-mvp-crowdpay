# CrowdPay Backend Environment Variables (Example)
#
# Copy this file to .env and fill in the values

# Flask Configuration
SECRET_KEY=your-secret-key-change-in-production
FLASK_DEBUG=True
FLASK_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Platform Fee (percentage, for tracking/display only - not deducted automatically)
PLATFORM_FEE_PERCENT=2.5

# Callback URL (public backend URL for LNURL payment callbacks, used in production)
CALLBACK_BASE_URL=http://localhost:5000

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
